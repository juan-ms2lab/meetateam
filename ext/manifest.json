{
  "manifest_version": 3,
  "name": "Room Kiosk Session",
  "version": "1.0",
  "permissions": ["alarms", "browsingData", "storage", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "bg.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"] }]
}
